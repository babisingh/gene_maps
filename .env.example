# ============================================================
# SpatialPharma (Gene_Maps) — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
#
# How to obtain each value:
#   Neo4j   → https://console.neo4j.io  (create a free AuraDB instance)
#   Neon    → https://neon.tech          (create a free Postgres project)
#   Upstash → https://upstash.com        (create a free Redis database)
# ============================================================

# ── Neo4j AuraDB ───────────────────────────────────────────
# Found in AuraDB console → "Connect" → "Connection URI"
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password-here

# ── PostgreSQL (Neon.tech recommended) ─────────────────────
# Found in Neon dashboard → your project → "Connection string"
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Redis / Upstash ────────────────────────────────────────
# Found in Upstash console → your database → "REST API"
REDIS_URL=rediss://default:your-upstash-password@your-db.upstash.io:6380
# OR use Upstash REST (serverless-friendly — preferred for Vercel):
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Application ────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── External API Configuration ─────────────────────────────
# No API keys needed — all free public REST APIs.
# Adjust timeouts (ms) if you are on a slow connection.
ENSEMBL_API_BASE=https://rest.ensembl.org
UCSC_API_BASE=https://api.genome.ucsc.edu
GTEX_API_BASE=https://gtexportal.org/api/v2
STRING_API_BASE=https://string-db.org/api

# External API request timeout in milliseconds
EXTERNAL_API_TIMEOUT_MS=10000

# ── Rate Limiting ──────────────────────────────────────────
# Max requests per minute to each external API
ENSEMBL_RATE_LIMIT_PER_MIN=60
STRING_RATE_LIMIT_PER_MIN=60

# ── Cache TTLs (seconds) ───────────────────────────────────
CACHE_TTL_GENE_SEARCH=600        # 10 minutes
CACHE_TTL_SPATIAL_SCORE=3600     # 1 hour
CACHE_TTL_CONSERVATION=86400     # 24 hours
CACHE_TTL_EXTERNAL_API=86400     # 24 hours
